{
  "version": 3,
  "vendor": {
    "comet": {
      "autoFormat": true
    }
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config",
      "description": "Default configuration for the project",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_POLICY_DEFAULT_CMP0135": "NEW"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "description": "Build with Microsoft Visual C++ (Debug)",
      "inherits": "default",
      "generator": "Visual Studio 17 2022",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "description": "Build with Microsoft Visual C++ (Release)",
      "inherits": "default",
      "generator": "Visual Studio 17 2022",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "description": "Build with Clang (Debug)",
      "inherits": "default",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "description": "Build with Clang (Release)",
      "inherits": "default",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "description": "Build with GCC (Debug)",
      "inherits": "default",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "description": "Build with GCC (Release)",
      "inherits": "default",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "displayName": "MSVC Debug Build",
      "description": "Build debug configuration with MSVC",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "displayName": "MSVC Release Build",
      "description": "Build release configuration with MSVC",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "displayName": "Clang Debug Build",
      "description": "Build debug configuration with Clang",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "displayName": "Clang Release Build",
      "description": "Build release configuration with Clang",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "displayName": "GCC Debug Build",
      "description": "Build debug configuration with GCC",
      "configuration": "Debug",
      "jobs": 0
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "displayName": "GCC Release Build",
      "description": "Build release configuration with GCC",
      "configuration": "Release",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "displayName": "MSVC Debug Tests",
      "description": "Run tests with MSVC Debug build",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "noTestsFailVector": false
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "displayName": "MSVC Release Tests",
      "description": "Run tests with MSVC Release build",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "noTestsFailVector": false
      }
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "displayName": "Clang Debug Tests",
      "description": "Run tests with Clang Debug build",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "noTestsFailVector": false
      }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "displayName": "Clang Release Tests",
      "description": "Run tests with Clang Release build",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "noTestsFailVector": false
      }
    },
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "displayName": "GCC Debug Tests",
      "description": "Run tests with GCC Debug build",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "noTestsFailVector": false
      }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "displayName": "GCC Release Tests",
      "description": "Run tests with GCC Release build",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": false,
        "noTestsFailVector": false
      }
    }
  ]
}
